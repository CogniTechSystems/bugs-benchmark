# Copy to .env and adjust as required. All settings are optional.

# Directory holding the SQLite database and downloaded models.
# BHB_DATA_DIR=./data

# Use another database, for example PostgreSQL (install the backend with the "postgres" extra).
# BHB_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bug_hunt_benchmark

# Address the web application listens on.
# BHB_HOST=127.0.0.1
# BHB_PORT=8000

# Hugging Face access token for gated or private repositories.
# BHB_HF_TOKEN=hf_xxx

# Host that managed runtimes bind to and are reached on.
# BHB_RUNTIME_HOST=127.0.0.1

# Agent limits.
# BHB_AGENT_MAX_ITERATIONS=60
# BHB_TOOL_OUTPUT_LIMIT=20000

# Scoring parameters.
# BHB_LINE_TOLERANCE=2
# BHB_FALSE_POSITIVE_PENALTY=0.5
# BHB_MINIMUM_TIME_FACTOR=0.5
# BHB_SCORING_TIMEOUT_SECONDS=120
